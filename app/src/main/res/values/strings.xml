    <!-- 引导页 - 欢迎 -->
    <string name="onboarding_welcome_title">欢迎使用 %1$s！</string>
    <string name="onboarding_welcome_description">记住各种物品的使用期限并不容易，尤其当冰箱和柜子里塞满了东西。\n\n%1$s 帮你记录家里有什么、留意即将到期的物品，在浪费之前及时用掉它们。</string>

    <!-- 引导页 - 管理物品 -->
    <string name="onboarding_manage_title">物品井井有条</string>
    <string name="onboarding_manage_description">添加你购买的物品，填写过期日期。清单会自动按日期排序，让你一眼看出哪些该先用。\n\n你还可以搜索物品、修改信息，用完后随时更新清单。</string>

    <!-- 引导页 - 通知权限 -->
    <string name="onboarding_notifications_title">不再错过任何到期日</string>
    <string name="onboarding_notifications_description">开启通知，在物品到期前收到提醒。</string>
    <string name="onboarding_notifications_enable">开启通知</string>
    <string name="onboarding_notifications_enabled">通知已开启！</string>
    <string name="onboarding_notifications_optional">你也可以暂时跳过，稍后在设置中开启。</string>

    <!-- 引导页 - 提醒时间 -->
    <string name="onboarding_time_title">选择提醒时间</string>
    <string name="onboarding_time_description">你希望每天什么时候收到到期提醒？</string>
    <string name="onboarding_time_save">保存提醒时间</string>
    <string name="onboarding_time_saved">提醒时间已保存！</string>

    <!-- 引导页 - 准备就绪 -->
    <string name="onboarding_ready_title">一切就绪！</string>
    <string name="onboarding_ready_description">现在可以开始记录物品和过期日期了。\n\n先从冰箱或柜子里的几样东西开始吧，%1$s 会帮你看出哪些该先用。</string>
    <string name="onboarding_ready_hint">你随时可以在设置中调整偏好。</string>
